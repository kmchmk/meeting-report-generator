# Cloud mode is disabled unless both gates are true.
ENABLE_CLOUD_MODE=true
VITE_ENABLE_CLOUD_MODE=true

# Recommended primary service: transcription + reports
GROQ_API_KEY=your_groq_api_key_here

# Free Gemini Developer API fallback for report generation.
# Free-tier content may be used by Google to improve its products; the app discloses this before consent.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional transcription fallbacks. Configure only the services you accept sending recordings to.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ASSEMBLYAI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ASR_MODEL=@cf/openai/whisper-large-v3-turbo
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_SPEECH_API_KEY=
